        <mxCell id="uz-wZKXDxPcc2NML6rjB-50" value="&lt;div&gt;&lt;span style=&quot;color: rgb(61, 82, 101); font-family: Roboto, Arial, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; font-weight: 400; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; background-color: light-dark(#ffffff, var(--ge-dark-color, #121212)); display: inline !important;&quot;&gt;&lt;h1 style=&quot;color: rgb(0, 0, 0); font-family: Helvetica; margin-top: 0px;&quot;&gt;Des services climatiques aux services scientifiques&amp;nbsp;&lt;/h1&gt;&lt;/span&gt;&lt;/div&gt;&lt;span style=&quot;color: rgb(61, 82, 101); font-family: Roboto, Arial, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;Un service &lt;u style=&quot;font-weight: bold;&quot;&gt;climatique&lt;/u&gt; est la fourniture d&#39;informations &lt;u style=&quot;font-weight: bold;&quot;&gt;climatiques&lt;/u&gt; pour aider les utilisateurs finaux à prendre des décisions intelligentes en matière de &lt;b&gt;&lt;u&gt;climat&lt;/u&gt;&lt;/b&gt;.&lt;/span&gt;&lt;div&gt;&lt;span style=&quot;color: rgb(61, 82, 101); font-family: Roboto, Arial, &amp;quot;Helvetica Neue&amp;quot;, Helvetica, sans-serif; font-size: 16px; font-style: normal; font-variant-ligatures: normal; font-variant-caps: normal; letter-spacing: normal; orphans: 2; text-align: start; text-indent: 0px; text-transform: none; widows: 2; word-spacing: 0px; -webkit-text-stroke-width: 0px; white-space: normal; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; display: inline !important;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;orphans: 2; text-align: start; text-indent: 0px; widows: 2; background-color: rgb(255, 255, 255); text-decoration-thickness: initial; text-decoration-style: initial; text-decoration-color: initial; float: none; color: rgb(61, 82, 101); display: inline !important;&quot;&gt;&lt;font style=&quot;font-size: 14px;&quot; face=&quot;Roboto, Arial, Helvetica Neue, Helvetica, sans-serif&quot; color=&quot;#3d5265&quot;&gt;&lt;i style=&quot;&quot;&gt;https://climate-adapt.eea.europa.eu/fr/knowledge/adaptation-information/climate-services&lt;/i&gt;&lt;/font&gt;&lt;/span&gt;&lt;/div&gt;" style="text;whiteSpace=wrap;html=1;" vertex="1" parent="1">
