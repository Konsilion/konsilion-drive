        <mxCell id="uz-wZKXDxPcc2NML6rjB-67" value="&lt;h1 style=&quot;margin-top: 0px;&quot;&gt;Code de la recherche&lt;/h1&gt;&lt;ul style=&quot;margin: -0.5em 0px 0px 1.6em; margin-inline: 1.6em 0px; padding: 0px; color: rgb(32, 33, 34); font-family: sans-serif; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot;&gt;&lt;li style=&quot;margin-bottom: 0.1em; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot;&gt;&lt;span&gt;Livre&amp;nbsp;&lt;abbr style=&quot;border-bottom: 0px; cursor: help; text-decoration-line: none; text-decoration-style: initial; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot; title=&quot;premier&quot; class=&quot;abbr&quot;&gt;I&lt;sup style=&quot;animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important; line-height: 1;&quot;&gt;er&lt;/sup&gt;&lt;/abbr&gt;&amp;nbsp;: l&#39;organisation générale de la recherche et du développement technologique&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom: 0.1em; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot;&gt;&lt;span&gt;Livre II&amp;nbsp;: l&#39;exercice des activités de recherche&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom: 0.1em; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot;&gt;&lt;span&gt;Livre III&amp;nbsp;: les établissements et organismes de recherche&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom: 0.1em; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot;&gt;&lt;span&gt;Livre IV&amp;nbsp;: les personnels de la recherche&lt;/span&gt;&lt;/li&gt;&lt;li style=&quot;margin-bottom: 0.1em; animation-delay: -0.01ms !important; animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; scroll-behavior: auto !important; transition-duration: 0ms !important;&quot;&gt;&lt;span&gt;Livre V&amp;nbsp;: la valorisation des résultats de la recherche et au transfert de technologie en direction du monde économique et de la société civile, ainsi que des associations et fondations reconnues d’utilité publique (crée en 2014)&lt;/span&gt;&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1800" y="790" width="470" height="230" as="geometry" />
